APP_NAME=Secure Authentication System
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Database: SQLite by default for zero-setup local execution (or PostgreSQL if desired)
DATABASE_URL=sqlite+aiosqlite:///./secure_auth.db

# Replace this placeholder with a strong random secret
JWT_SECRET_KEY=replace_with_a_random_secret_of_at_least_32_bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# Cookie configuration for local development
REFRESH_COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Frontend origins allowed by CORS
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# SMTP email configuration — fill in when email is configured
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true

# Google OAuth — configure later
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/google/callback

# GitHub OAuth — configure later
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/github/callback